            <groupId>com.pilog.mdm.cloud</groupId>
            <artifactId>iDXPBusinessLogic</artifactId>
            <version>1</version>
        </dependency>
        <dependency>
            <groupId>com.pilog.mdm.cloud</groupId>
            <artifactId>iDXPPojos2</artifactId>
            <version>1</version>
        </dependency>
        <dependency>
            <groupId>com.pilog.mdm.cloud</groupId>
            <artifactId>iDXPPojos</artifactId>
            <version>1</version>
        </dependency>
        <dependency>
            <groupId>com.pilog.mdm</groupId>
            <artifactId>iDXPServiceClient</artifactId>
            <version>1</version>
        </dependency>
        <dependency>
            <groupId>com.pilog.mdm.cloud</groupId>
            <artifactId>iDXPDescriptionRenderer</artifactId>
            <version>1</version>
        </dependency>
        <dependency>
            <groupId>com.itextpdf.tool</groupId>
            <artifactId>xmlworker</artifactId>
            <version>5.5.13.3</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>com.pilog.service</groupId>
